        "PowerShell .NET": {
            "source": "PowerShell",
            "args": [
                "-NoExit",
                "-Command", "cd '${workspaceFolder}'; $env:PATH = '${workspaceFolder}\\.dotnet;' + $env:PATH; Write-Host '.NET environment configured!' -ForegroundColor Green; Write-Host 'Using .NET from: ${workspaceFolder}\\.dotnet\\dotnet.exe' -ForegroundColor Cyan"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell"
